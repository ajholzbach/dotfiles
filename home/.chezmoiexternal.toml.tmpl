{{- /* macOS installs this font with Homebrew in run_after_17-install-font-macos */ -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   $fontDir := ".local/share/fonts" -}}
# One entry per file, so chezmoi does not own the font directory
{{-   range list "Regular" "Bold" "Italic" "BoldItalic" }}
{{-     $font := printf "MesloLGSNerdFont-%s.ttf" . }}

[{{ printf "%s/%s" $fontDir $font | quote }}]
    type = "archive-file"
    # Pinned, because a refresh of a latest URL fails every command when offline
    url = "https://github.com/ryanoasis/nerd-fonts/releases/download/v3.5.1/Meslo.tar.xz"
    path = {{ $font | quote }}
{{-   end }}
{{- end }}

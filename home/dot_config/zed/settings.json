{
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "left",
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
    "dockerfile": true,
    "git-firefly": true,
    "terraform": true,
    "toml": true,
  },
  "auto_signature_help": true,
  "buffer_font_family": "MesloLGS Nerd Font",
  "buffer_font_size": 14,
  "code_lens": "on",
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "icon_theme": "Catppuccin Mocha",
  "inlay_hints": {
    "enabled": true,
  },
  "languages": {
    "Python": {
      "language_servers": ["ty", "!basedpyright", "..."],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
        "source.fixAll.ruff": true,
      },
    },
    "Go": {
      "format_on_save": "on",
    },
  },
  "lsp": {
    "ty": {
      "initialization_options": {
        "experimental": {
          "useUv": "scripts",
        },
      },
    },
  },
  "project_panel": {
    "dock": "right",
  },
  "semantic_tokens": "combined",
  "sticky_scroll": {
    "enabled": true,
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "Catppuccin Latte",
    "mode": "system",
  },
  "ui_font_family": "MesloLGS Nerd Font",
  "ui_font_size": 14,
}

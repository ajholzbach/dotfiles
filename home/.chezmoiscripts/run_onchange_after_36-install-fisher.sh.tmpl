{{- if and (index . "tools") (ne .chezmoi.os "windows") -}}
{{ template "tools-script.sh" . }}
# Run again when the plugin list changes or Fish is installed: {{ ne (includeTemplate "tool-path" "fish") "" }}
PLUGINS='{{ include "dot_config/fish/fish_plugins" | trim }}'

if ! fish_bin="$(find_tool fish)"; then
    printf 'Fish is not installed; skipping Fisher.\n'
    exit 0
fi

run_fish() {
    DOTFILES_LOADING_LOCAL_ENV=1 XDG_CONFIG_HOME="$HOME/.config" "$fish_bin" "$@"
}

# Fisher keeps exactly the plugins in fish_plugins, including itself.
# shellcheck disable=SC2016 # Fish expands these variables
if run_fish -c 'contains jorgebucaran/fisher $_fisher_plugins'; then
    printf 'Syncing Fish plugins with Fisher...\n'
    run_fish -c 'fisher update'
else
    printf 'Installing Fisher and the Fish plugins...\n'
    download_installer https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish
    # Fisher does not overwrite copies of itself that it does not own, so move
    # them aside and put them back if Fisher fails.
    fisher_dir="$(run_fish -c 'set -q fisher_path; or set fisher_path $__fish_config_dir
        echo $fisher_path')"
    for file in "$fisher_dir/functions/fisher.fish" "$fisher_dir/completions/fisher.fish"; do
        [ ! -f "$file" ] || mv "$file" "$file.dotfiles-old"
    done
    run_fish -c 'source $argv[1]; and fisher update' "$installer" || true
    for file in "$fisher_dir/functions/fisher.fish" "$fisher_dir/completions/fisher.fish"; do
        [ -f "$file.dotfiles-old" ] || continue
        if [ -f "$file" ]; then
            rm -f "$file.dotfiles-old"
        else
            mv "$file.dotfiles-old" "$file"
        fi
    done
fi

# Fisher exits 0 when a plugin download fails, so check the result
installed="$(run_fish -c 'fisher list')"
for plugin in $PLUGINS; do
    printf '%s\n' "$installed" | grep -Fqx -e "$plugin" || \
        die "Fisher did not install $plugin."
done
{{ end -}}

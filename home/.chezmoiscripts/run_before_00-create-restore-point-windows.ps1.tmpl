{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
{{ template "powershell-state.ps1" . }}
{{ template "powershell-profile-paths.ps1" . }}
$currentBackup = Join-Path $stateRoot 'current-backup'
$backupsDir = Join-Path $stateRoot 'backups'

function Test-SafeRelativePath {
    param([string]$Path)

    return -not [string]::IsNullOrWhiteSpace($Path) -and
        -not [IO.Path]::IsPathRooted($Path) -and
        -not (($Path -split '[\\/]') -contains '..')
}

function Test-RealDirectory {
    param([string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) {
        return $false
    }

    $item = Get-Item -LiteralPath $Path -Force
    return $item.PSIsContainer -and -not $item.LinkType
}

function Copy-PathPreservingLink {
    param(
        [string]$Source,
        [string]$Destination
    )

    New-Item -ItemType Directory -Path (Split-Path -Parent $Destination) -Force | Out-Null
    $item = Get-Item -LiteralPath $Source -Force
    if ($item.LinkType -in @('SymbolicLink', 'Junction')) {
        New-Item -ItemType $item.LinkType -Path $Destination -Target (@($item.Target)[0]) -Force | Out-Null
    } else {
        Copy-Item -LiteralPath $Source -Destination $Destination -Force
    }
}

# Pass on the outer apply's paths, so a custom source or destination is used
$destDir = '{{ .chezmoi.destDir | replace "'" "''" }}'
$managed = @(& '{{ .chezmoi.executable | replace "'" "''" }}' `
        --source '{{ .chezmoi.sourceDir | replace "'" "''" }}' `
        --config '{{ .chezmoi.configFile | replace "'" "''" }}' `
        --destination $destDir managed --include=files,symlinks --path-style=relative)
if ($LASTEXITCODE -ne 0 -or $managed.Count -eq 0) {
    throw 'chezmoi returned no managed files; refusing to apply without a restore manifest.'
}
$currentManagedSet = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
foreach ($relativePath in $managed) {
    if (-not (Test-SafeRelativePath -Path $relativePath)) {
        throw "Unsafe managed path from chezmoi: $relativePath"
    }
    if (-not $currentManagedSet.Add($relativePath)) {
        throw "chezmoi returned a duplicate managed path: $relativePath"
    }
    $target = Join-Path $destDir $relativePath
    if (Test-RealDirectory -Path $target) {
        throw "Refusing to replace a directory where a managed file or symlink is expected: $target"
    }
}

$savedManaged = [System.Collections.Generic.List[string]]::new()
$savedManagedSet = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
$savedExisting = [System.Collections.Generic.List[string]]::new()
$savedExistingSet = [System.Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)
$isNewBackup = -not (Test-Path -LiteralPath $currentBackup)
if ($isNewBackup) {
    $backupId = '{0}-{1}' -f [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ'), $PID
    # Build in a staging directory and publish only when complete
    $backupDir = Join-Path $backupsDir ".$backupId.tmp"
} else {
    $backupId = [IO.File]::ReadAllText($currentBackup).Trim()
    if ([string]::IsNullOrWhiteSpace($backupId) -or
        $backupId.Contains('..') -or
        $backupId.Contains('/') -or
        $backupId.Contains('\')) {
        throw "Invalid dotfiles restore-point identifier in ${currentBackup}: $backupId"
    }

    $backupDir = Join-Path $backupsDir $backupId
    foreach ($manifest in @('managed-files.txt', 'existing-files.txt', 'powershell-profiles.json')) {
        if (-not (Test-Path -LiteralPath (Join-Path $backupDir $manifest) -PathType Leaf)) {
            throw "Existing dotfiles restore point is incomplete: $backupDir"
        }
    }

    foreach ($relativePath in [IO.File]::ReadAllLines((Join-Path $backupDir 'managed-files.txt'))) {
        if (-not (Test-SafeRelativePath -Path $relativePath) -or -not $savedManagedSet.Add($relativePath)) {
            throw "Unsafe or duplicate path in existing restore manifest: $relativePath"
        }
        $savedManaged.Add($relativePath)
    }

    foreach ($relativePath in [IO.File]::ReadAllLines((Join-Path $backupDir 'existing-files.txt'))) {
        $savedBackup = Join-Path (Join-Path $backupDir 'files') $relativePath
        if ((-not $savedManagedSet.Contains($relativePath) -and
                -not $currentManagedSet.Contains($relativePath)) -or
            -not (Test-Path -LiteralPath $savedBackup) -or
            (Test-RealDirectory -Path $savedBackup) -or
            -not $savedExistingSet.Add($relativePath)) {
            throw "Unsafe or duplicate path in existing-files manifest: $relativePath"
        }
        $savedExisting.Add($relativePath)
    }
}

try {
    # Back up only new targets, so each target keeps its original backup
    $addedCount = 0
    foreach ($relativePath in $managed) {
        if (-not $savedManagedSet.Add($relativePath)) {
            continue
        }
        $target = Join-Path $destDir $relativePath
        if ((Test-Path -LiteralPath $target) -and $savedExistingSet.Add($relativePath)) {
            Copy-PathPreservingLink -Source $target -Destination (Join-Path (Join-Path $backupDir 'files') $relativePath)
            $savedExisting.Add($relativePath)
        }
        $savedManaged.Add($relativePath)
        $addedCount++
    }

    if ($addedCount -gt 0) {
        # Replace existing-files first. An interruption between the two
        # replacements leaves a safely detectable mismatch, never a new
        # target that uninstall would incorrectly treat as disposable.
        Write-StateFile (Join-Path $backupDir 'existing-files.txt') $savedExisting
        Write-StateFile (Join-Path $backupDir 'managed-files.txt') $savedManaged
    }

    if ($isNewBackup) {
        $profileRecords = for ($index = 0; $index -lt $profilePaths.Count; $index++) {
            $profilePath = $profilePaths[$index]
            if (Test-RealDirectory -Path $profilePath) {
                throw "Refusing to replace a directory where a PowerShell profile file is expected: $profilePath"
            }
            $exists = Test-Path -LiteralPath $profilePath
            if ($exists) {
                Copy-PathPreservingLink -Source $profilePath -Destination (Join-Path $backupDir "profiles\$index")
            }
            [PSCustomObject]@{
                Path = $profilePath
                Existed = $exists
                Backup = "profiles/$index"
            }
        }
        Write-StateFile (Join-Path $backupDir 'powershell-profiles.json') ($profileRecords | ConvertTo-Json -Depth 3)

        $publishedDir = Join-Path $backupsDir $backupId
        Move-Item -LiteralPath $backupDir -Destination $publishedDir
        Write-StateFile $currentBackup $backupId
        Write-Host "Created pre-install restore point: $publishedDir"
    } elseif ($addedCount -gt 0) {
        Write-Host "Added $addedCount newly managed target(s) to restore point: $backupId"
    } else {
        Write-Host "Keeping existing dotfiles restore point: $backupId"
    }
} finally {
    if ($isNewBackup -and (Test-Path -LiteralPath $backupDir)) {
        Remove-Item -LiteralPath $backupDir -Recurse -Force
    }
}
{{- end }}

{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'

# Run on every apply to repair recreated profiles and keep user content
{{ template "powershell-profile-paths.ps1" . }}
$beginMarker = '# >>> dotfiles managed PowerShell profile >>>'
$endMarker = '# <<< dotfiles managed PowerShell profile <<<'
$sourceLine = '. (Join-Path (Join-Path $HOME ''.config'') ''powershell\profile.ps1'')'
$escapedBeginMarker = [regex]::Escape($beginMarker)
$escapedEndMarker = [regex]::Escape($endMarker)
$markerPattern = $escapedBeginMarker + '|' + $escapedEndMarker
$blockPattern = '(?ms)^' + $escapedBeginMarker + '\r?\n.*?^' +
    $escapedEndMarker + '\r?(?:\n|$)'

# Read-ProfileText PATH: return the profile text and the encoding to write it
# back with. Text without a BOM that is not valid UTF-8 uses the ANSI code page.
function Read-ProfileText {
    param([string]$Path)

    $reader = [IO.StreamReader]::new($Path, [Text.UTF8Encoding]::new($false, $true), $true)
    try {
        $content = $reader.ReadToEnd()
        # A UTF-16 or UTF-32 BOM selects a decoder that replaces bad bytes
        # Stop when the text has U+FFFD
        if ($content.Contains([char]0xFFFD)) {
            throw "Refusing to rewrite $Path because it is not valid $($reader.CurrentEncoding.WebName)."
        }
        return [PSCustomObject]@{ Content = $content; Encoding = $reader.CurrentEncoding }
    } catch [Text.DecoderFallbackException] {
        $encoding = [Text.Encoding]::GetEncoding([Globalization.CultureInfo]::CurrentCulture.TextInfo.ANSICodePage)
        return [PSCustomObject]@{ Content = $encoding.GetString([IO.File]::ReadAllBytes($Path)); Encoding = $encoding }
    } finally {
        $reader.Dispose()
    }
}

$updates = foreach ($profilePath in $profilePaths) {
    $content = ''
    $encoding = [Text.UTF8Encoding]::new($true)
    if (Test-Path -LiteralPath $profilePath) {
        $profileText = Read-ProfileText -Path $profilePath
        $content = $profileText.Content
        $encoding = $profileText.Encoding
    }

    # Every marker must be the first or last line of one complete block
    $managedBlocks = [regex]::Matches($content, $blockPattern)
    if ([regex]::Matches($content, $markerPattern).Count -ne 2 * $managedBlocks.Count) {
        throw "Malformed managed PowerShell profile markers in $profilePath; restore or remove the partial marker before applying."
    }

    $newline = if ($content.Contains("`r`n")) {
        "`r`n"
    } elseif ($content.Contains("`n")) {
        "`n"
    } else {
        [Environment]::NewLine
    }
    $block = @($beginMarker, $sourceLine, $endMarker) -join $newline

    if ($managedBlocks.Count -gt 0) {
        $firstBlock = $managedBlocks[0]
        $afterBlock = [regex]::Replace($content.Substring($firstBlock.Index + $firstBlock.Length), $blockPattern, '')
        $updated = $content.Substring(0, $firstBlock.Index) + $block + $newline + $afterBlock
    } else {
        $separator = if ($content -and -not $content.EndsWith("`n")) { $newline } else { '' }
        $updated = $content + $separator + $block + $newline
    }

    [PSCustomObject]@{
        Path = $profilePath
        Content = $content
        Updated = $updated
        Encoding = $encoding
    }
}

# Validate both profiles before changing either one
foreach ($update in $updates) {
    if ($update.Updated -ceq $update.Content) {
        continue
    }
    New-Item -ItemType Directory -Path (Split-Path -Parent $update.Path) -Force | Out-Null
    $temporary = "$($update.Path).dotfiles.$PID.tmp"
    try {
        [IO.File]::WriteAllText($temporary, $update.Updated, $update.Encoding)
        if (Test-Path -LiteralPath $update.Path) {
            # Replace keeps the attributes and access rules of the existing file
            [IO.File]::Replace($temporary, $update.Path, [NullString]::Value)
        } else {
            Move-Item -LiteralPath $temporary -Destination $update.Path
        }
        Write-Host "Updated PowerShell profile shim: $($update.Path)"
    } finally {
        if (Test-Path -LiteralPath $temporary) {
            Remove-Item -LiteralPath $temporary -Force
        }
    }
}
{{- end }}

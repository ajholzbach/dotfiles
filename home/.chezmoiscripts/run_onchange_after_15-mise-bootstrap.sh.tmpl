{{- if and (index . "tools") (ne .chezmoi.os "windows") -}}
{{ template "tools-script.sh" . }}
# Run again when the tool config changes: {{ include "dot_config/mise/conf.d/10-dotfiles-tools.toml" | sha256sum }}
MISE_PATH="$HOME/.local/bin/mise"
{{- if eq .chezmoi.os "darwin" }}

if ! find_tool brew >/dev/null; then
    printf 'Installing Homebrew...\n'
    download_installer https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
    /bin/bash "$installer"
    find_tool brew >/dev/null || die "the Homebrew installer did not produce a brew executable."
fi
{{- end }}

mise_bin="$(command -v mise 2>/dev/null || printf '%s' "$MISE_PATH")"
if [ ! -x "$mise_bin" ]; then
    printf 'Installing mise into %s...\n' "$MISE_PATH"
    download_installer https://mise.run
    MISE_INSTALL_PATH="$MISE_PATH" sh "$installer"
    mise_bin="$MISE_PATH"
fi
"$mise_bin" bootstrap --help >/dev/null 2>&1 || \
    die "mise $("$mise_bin" --version) has no bootstrap command. Update mise, then apply again."
{{- if eq .chezmoi.os "linux" }}

# apt fails when another source for the fish 4 PPA has a different Signed-By
# Delete the fish 4 PPA sources from add-apt-repository or older dotfiles
for fish_source in /etc/apt/sources.list.d/*; do
    case "$fish_source" in */mise-fish-shell-release-4.sources) continue ;; esac
    grep -Fqs ppa.launchpadcontent.net/fish-shell/release-4 "$fish_source" || continue
    sudo rm -f "$fish_source"
    printf 'Removed %s, because mise adds the fish 4 PPA.\n' "$fish_source"
done
# Delete the key that older dotfiles wrote for their fish 4 PPA source
if [ -e /etc/apt/keyrings/fish-shell-release-4.asc ]; then
    sudo rm -f /etc/apt/keyrings/fish-shell-release-4.asc
fi
{{- end }}

printf 'Installing recommended tools with mise bootstrap...\n'
XDG_CONFIG_HOME="$HOME/.config" "$mise_bin" bootstrap --only packages,tools --yes
{{- if eq .chezmoi.os "darwin" }}

# The one-line install puts chezmoi in ~/.local/bin, which would shadow updates from Homebrew
# Remove that copy when Homebrew provides chezmoi
local_chezmoi="$HOME/.local/bin/chezmoi"
if [ -x "$local_chezmoi" ] && brew_bin="$(find_tool brew)" &&
        [ -x "$("$brew_bin" --prefix)/bin/chezmoi" ]; then
    rm -f "$local_chezmoi"
    printf 'Removed %s, because Homebrew provides chezmoi.\n' "$local_chezmoi"
fi
{{- end }}
{{ end -}}

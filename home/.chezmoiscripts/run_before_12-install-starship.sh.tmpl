{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{ template "common.sh" . }}
umask 077

INSTALL_DIR="$HOME/.local/bin"
STARSHIP_PATH="$INSTALL_DIR/starship"
INSTALL_MARKER="$STATE_ROOT/starship-installed-by-dotfiles"

if command -v starship >/dev/null 2>&1 || [ -e "$STARSHIP_PATH" ]; then
    printf 'Starship is already installed.\n'
    exit 0
fi

printf 'Installing the latest Starship into %s...\n' "$INSTALL_DIR"
download_installer https://starship.rs/install.sh
mkdir -p "$INSTALL_DIR"
sh "$installer" --yes --bin-dir "$INSTALL_DIR"
if ! "$STARSHIP_PATH" --version >/dev/null 2>&1; then
    rm -f "$STARSHIP_PATH"
    die "the Starship installer did not produce a working executable."
fi

mkdir -p "$STATE_ROOT"
# Uninstall removes Starship only while it still has this checksum.
{ sha256sum "$STARSHIP_PATH" 2>/dev/null || shasum -a 256 "$STARSHIP_PATH"; } |
    cut -d ' ' -f 1 > "$INSTALL_MARKER"
{{- end }}

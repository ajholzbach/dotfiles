{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{ template "common.sh" . }}
umask 077

if ! fish_bin="$(find_tool fish)"; then
    exit 0
fi

# Save and erase universals from older dotfiles that override current settings
RESTORE="$STATE_ROOT/fish-universals-restore.fish"
mkdir -p "$STATE_ROOT"
saved="$(mktemp "$STATE_ROOT/.fish-universals.XXXXXX")"
trap 'rm -f "$saved"' EXIT

fish_status=0
# shellcheck disable=SC2016 # Fish expands these variables
DOTFILES_LOADING_LOCAL_ENV=1 XDG_CONFIG_HOME="$HOME/.config" "$fish_bin" -c '
    for name in FZF_DEFAULT_OPTS MISE_FISH_AUTO_ACTIVATE \
            (string match -r "^fish_(?:pager_)?color_.*" -- (set -nU))
        set -qU $name; or continue
        set -l flags -U
        contains -- $name (set -nUx); and set -a flags -x
        echo set $flags $name (string escape -- $$name)
        set -eU $name
    end' > "$saved" || fish_status=$?

# The oldest values must win when uninstall runs these lines
# Append the older saves after the new ones
if [ -s "$saved" ]; then
    [ ! -f "$RESTORE" ] || cat "$RESTORE" >> "$saved"
    mv "$saved" "$RESTORE"
    printf 'Erased stale Fish universal variables. Uninstall restores them.\n'
fi
exit "$fish_status"
{{- end }}

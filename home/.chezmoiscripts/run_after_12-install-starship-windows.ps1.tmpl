{{- if eq .chezmoi.os "windows" -}}
$ErrorActionPreference = 'Stop'
{{ template "powershell-state.ps1" . }}
$starshipVersionPattern = '(?m)^starship (?<Version>(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)\.(?:0|[1-9]\d*)(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?)(?:\s|$)'

# Invoke-Native NAME ARGUMENTS: run a command and throw when it fails. Check $?
# too because PowerShell shims such as scoop do not always set $LASTEXITCODE.
function Invoke-Native {
    param([string]$Name, [string[]]$Arguments)

    $global:LASTEXITCODE = $null
    & $Name @Arguments
    $succeeded = $?
    if (-not $succeeded -or ($null -ne $LASTEXITCODE -and $LASTEXITCODE -ne 0)) {
        $exitDescription = if ($null -eq $LASTEXITCODE) { 'PowerShell command failure' } else { "exit $LASTEXITCODE" }
        throw "$Name $($Arguments -join ' ') failed ($exitDescription)."
    }
}

# Get-StarshipVersion: print the semantic version that starship reports, or
# nothing when it fails or reports something else.
function Get-StarshipVersion {
    try {
        $output = @(Invoke-Native starship @('--version')) -join "`n"
    } catch {
        return
    }
    $match = [regex]::Match($output, $starshipVersionPattern)
    if ($match.Success) {
        $match.Groups['Version'].Value
    }
}

if (Get-Command starship -ErrorAction SilentlyContinue) {
    $existingVersion = Get-StarshipVersion
    if (-not $existingVersion) {
        throw "A command named 'starship' is on PATH, but it did not return a valid version."
    }
    Write-Host "Starship is already installed: $existingVersion"
    exit 0
}

if (Get-Command winget -ErrorAction SilentlyContinue) {
    $manager = 'winget'
    $installArguments = @('install', '--id', 'Starship.Starship', '--exact', '--source', 'winget', '--scope', 'user',
        '--installer-type', 'portable', '--accept-package-agreements', '--accept-source-agreements', '--silent')
} elseif (Get-Command scoop -ErrorAction SilentlyContinue) {
    $manager = 'scoop'
    $installArguments = @('install', 'starship')
} else {
    throw 'Install winget or Scoop, then re-run chezmoi apply to install Starship.'
}
Write-Host "Installing Starship with $manager..."
Invoke-Native $manager $installArguments

# Record ownership immediately after a successful package operation. If PATH
# refresh or version validation fails, uninstall can still remove the package.
$marker = Join-Path $stateRoot 'starship-installed-by-dotfiles'
Write-StateFile $marker (@{ Manager = $manager } | ConvertTo-Json -Compress)

$env:PATH = @($env:PATH,
    [Environment]::GetEnvironmentVariable('Path', 'Machine'),
    [Environment]::GetEnvironmentVariable('Path', 'User')) -match '\S' -join [IO.Path]::PathSeparator

if (-not (Get-Command starship -ErrorAction SilentlyContinue)) {
    throw 'Starship was installed and ownership was recorded, but its executable is not available on PATH. Open a new PowerShell and re-run chezmoi apply, or run the dotfiles uninstaller.'
}

$installedVersion = Get-StarshipVersion
if (-not $installedVersion) {
    throw 'Starship was installed, but did not return a valid semantic version. Package ownership was recorded for uninstall.'
}
Write-StateFile $marker ([ordered]@{ Manager = $manager; Version = $installedVersion } | ConvertTo-Json -Compress)
Write-Host "Installed Starship $installedVersion with $manager."
{{- end }}

{{- if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
{{ template "common.sh" . }}
umask 077

CURRENT_BACKUP="$STATE_ROOT/current-backup"

# The restore point holds the union of every path this repository has
# managed. This script runs before every apply, so a path added by a later
# repository update is captured before chezmoi first changes it.
if [ -f "$CURRENT_BACKUP" ]; then
    backup_id="$(sed -n '1p' "$CURRENT_BACKUP")"
    case "$backup_id" in
        ''|*/*|*'..'*) die "invalid restore-point identifier: $backup_id" ;;
    esac
    backup_dir="$STATE_ROOT/backups/$backup_id"
    [ -s "$backup_dir/managed-files.txt" ] && [ -f "$backup_dir/existing-files.txt" ] || \
        die "restore point $backup_id is incomplete; refusing to apply."
else
    backup_id="$(date -u '+%Y%m%dT%H%M%SZ')-$$"
    backup_dir="$STATE_ROOT/backups/$backup_id"
    mkdir -p "$backup_dir/files"
    : > "$backup_dir/managed-files.txt"
    : > "$backup_dir/existing-files.txt"
fi

current="$backup_dir/.current-managed.$$"
next_managed="$backup_dir/.managed-files.$$"
next_existing="$backup_dir/.existing-files.$$"
new_paths="$backup_dir/.new-managed.$$"
trap 'rm -f "$current" "$next_managed" "$next_existing" "$new_paths"' EXIT

# Pass on the outer apply's paths, so a custom source or destination is used
DEST_DIR={{ .chezmoi.destDir | quote }}
{{ .chezmoi.executable | quote }} --source {{ .chezmoi.sourceDir | quote }} \
    --config {{ .chezmoi.configFile | quote }} --destination "$DEST_DIR" \
    managed --include=files,symlinks --path-style=relative > "$current"
[ -s "$current" ] || die "chezmoi returned no managed files; refusing to apply without a restore point."
cp -p "$backup_dir/managed-files.txt" "$next_managed"
cp -p "$backup_dir/existing-files.txt" "$next_existing"
# FILENAME, not NR == FNR, because the saved list is empty on the first apply
awk 'FILENAME == ARGV[1] { seen[$0] = 1; next } !($0 in seen)' "$next_managed" "$current" > "$new_paths"

added=0
while IFS= read -r relative_path; do
    target="$DEST_DIR/$relative_path"
    if [ -d "$target" ] && [ ! -L "$target" ]; then
        die "refusing to replace a directory where chezmoi expects a file: $target"
    fi
    if [ -e "$target" ] || [ -L "$target" ]; then
        destination="$backup_dir/files/$relative_path"
        mkdir -p "$(dirname "$destination")"
        cp -pP "$target" "$destination"
        printf '%s\n' "$relative_path" >> "$next_existing"
    fi
    printf '%s\n' "$relative_path" >> "$next_managed"
    added=$((added + 1))
done < "$new_paths"

# Move the existing-file manifest first. An interrupted apply then leaves a
# managed path unrecorded, and the next apply captures it again.
mv "$next_existing" "$backup_dir/existing-files.txt"
mv "$next_managed" "$backup_dir/managed-files.txt"

if [ ! -f "$CURRENT_BACKUP" ]; then
    printf '%s\n' "$backup_id" > "$CURRENT_BACKUP.$$"
    mv "$CURRENT_BACKUP.$$" "$CURRENT_BACKUP"
    printf 'Created pre-install restore point: %s\n' "$backup_dir"
elif [ "$added" -gt 0 ]; then
    printf 'Extended the restore point with %s new managed path(s): %s\n' "$added" "$backup_dir"
fi
{{- end }}

if [[ ! -o login && -f $HOME/.profile ]]; then
    source "$HOME/.profile"
fi

typeset -U path fpath
[[ -n ${HOMEBREW_PREFIX:-} ]] && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)

# History and completion settings from OMZ lib
HISTFILE=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
# hist_expire_dups_first needs HISTSIZE above SAVEHIST
HISTSIZE=60000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify share_history
setopt auto_menu complete_in_word always_to_end
_dotfiles_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
zstyle ':completion:*' menu select
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "$_dotfiles_zsh_cache"

# Run the slow compaudit check at most once a day
[[ -d $_dotfiles_zsh_cache ]] || mkdir -p "$_dotfiles_zsh_cache"
autoload -Uz compinit
() {
    setopt local_options extended_glob
    if [[ -n $1(#qN.mh-24) ]]; then
        compinit -C -d "$1"
    else
        compinit -d "$1"
        touch "$1"
    fi
    [[ $1.zwc -nt $1 ]] || zcompile "$1"
} "$_dotfiles_zsh_cache/zcompdump"

# Lazy-load Conda from CONDA_EXE, PATH, or common macOS and Linux locations
_dotfiles_conda_roots=(
    "$HOME/miniforge3" "$HOME/miniconda3" "$HOME/anaconda3" "$HOME/mambaforge"
    /opt/miniforge3 /opt/miniconda3 /opt/anaconda3 /opt/conda
)
[[ -n ${HOMEBREW_PREFIX:-} ]] &&
    _dotfiles_conda_roots+=("$HOMEBREW_PREFIX"/Caskroom/{miniforge,miniconda,mambaforge,anaconda}/base)
if [[ -x ${CONDA_EXE:-} ]]; then
    _dotfiles_conda_exe=$CONDA_EXE
elif (( $+commands[conda] )); then
    _dotfiles_conda_exe=$commands[conda]
else
    for _dotfiles_conda_root in $_dotfiles_conda_roots; do
        if [[ -x $_dotfiles_conda_root/bin/conda ]]; then
            _dotfiles_conda_exe=$_dotfiles_conda_root/bin/conda
            break
        fi
    done
fi
if [[ -n ${_dotfiles_conda_exe:-} ]]; then
    conda() {
        unset -f conda
        local conda_hook
        if ! conda_hook="$("$_dotfiles_conda_exe" shell.zsh hook 2>/dev/null)" || \
                [[ -z $conda_hook ]] || ! eval "$conda_hook"; then
            export PATH="${_dotfiles_conda_exe:h}:$PATH"
        fi
        unset _dotfiles_conda_exe
        conda "$@"
    }
fi
unset _dotfiles_conda_root _dotfiles_conda_roots

# Lazy-load NVM
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
for _dotfiles_nvm_script in "$NVM_DIR/nvm.sh" ${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/opt/nvm/nvm.sh"}; do
    if [[ -s $_dotfiles_nvm_script ]]; then
        nvm() {
            unset -f nvm
            . "$_dotfiles_nvm_script"
            unset _dotfiles_nvm_script
            nvm "$@"
        }
        break
    fi
done
if (( ! $+functions[nvm] )); then
    unset _dotfiles_nvm_script
fi

# Add pnpm's home when it exists
if [[ -z ${PNPM_HOME:-} ]]; then
    for _dotfiles_pnpm_home in "$HOME/Library/pnpm" "$HOME/.local/share/pnpm"; do
        if [[ -d $_dotfiles_pnpm_home ]]; then
            export PNPM_HOME="$_dotfiles_pnpm_home"
            break
        fi
    done
    unset _dotfiles_pnpm_home
fi
[[ -n ${PNPM_HOME:-} ]] && path=("$PNPM_HOME" $path)

if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

# Tool init commands print the same script each time, but take 5 to 10 ms each
# Source the script from a cache file, and rebuild the file when the tool binary changes
zmodload -F zsh/stat b:zstat
_dotfiles_source_init() {
    local bin=${commands[$1]:A} cache=$_dotfiles_zsh_cache/$1-init.zsh key line init
    local -a mtime
    [[ -n $bin ]] && zstat -A mtime +mtime -- "$bin" || return
    key="# $bin $mtime"
    [[ -r $cache ]] && read -r line < "$cache"
    if [[ $line != "$key" ]]; then
        init=$("$@" 2>/dev/null) && [[ -n $init ]] || return
        # Another shell can start while this shell writes the cache
        # Write a temp file, then rename the temp file to the cache file
        print -r -- "$key"$'\n'"$init" >| "$cache.$$" && mv -f "$cache.$$" "$cache"
    fi
    source "$cache"
}

if _dotfiles_source_init zoxide init zsh --cmd cd; then
    alias cdo='builtin cd'
fi

if (( $+commands[bat] )); then
    alias cat='bat --plain'
fi

if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l --group-directories-first --icons=auto'
    alias la='eza -a --group-directories-first --icons=auto'
    alias lt='eza -aT --group-directories-first --icons=auto'
fi

# fzf before 0.48 has no --zsh option, but Debian and Ubuntu ship its scripts
# Use those scripts when fzf --zsh fails
if (( $+commands[fzf] )) && ! _dotfiles_source_init fzf --zsh; then
    for _dotfiles_fzf_script in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh; do
        [[ -f $_dotfiles_fzf_script ]] && source "$_dotfiles_fzf_script"
    done
    unset _dotfiles_fzf_script
fi

if _dotfiles_source_init starship init zsh; then
    # starship.toml has no right_format, but the right prompt still runs starship
    # Clear the right prompt
    RPROMPT=''
fi
unfunction _dotfiles_source_init
unset _dotfiles_zsh_cache

# The OMZ git plugin aliases expect this OMZ lib function
git_current_branch() {
    command git symbolic-ref --quiet --short HEAD 2>/dev/null ||
        command git rev-parse --short HEAD 2>/dev/null
}

# zsh-syntax-highlighting must wrap every widget
# Load Antidote last, from ~/.antidote or from Homebrew on macOS with tools
_dotfiles_antidote="$HOME/.antidote/antidote.zsh"
[[ -f $_dotfiles_antidote || -z ${HOMEBREW_PREFIX:-} ]] ||
    _dotfiles_antidote="$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh"
if [[ -f $_dotfiles_antidote ]]; then
    # Rebuild the cached bundle only when the plugin list changes
    _dotfiles_plugins_txt="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
    _dotfiles_plugins_bundle="${XDG_CACHE_HOME:-$HOME/.cache}/antidote/zsh_plugins.zsh"
    if [[ ! $_dotfiles_plugins_bundle -nt $_dotfiles_plugins_txt ]]; then
        mkdir -p "${_dotfiles_plugins_bundle:h}"
        source "$_dotfiles_antidote"
        zstyle ':antidote:bundle:*' zcompile yes
        # Defer only the plugin load, and skip the prompt hooks and redraw
        zstyle ':antidote:bundle:*' defer-options '-a'
        _dotfiles_plugins_tmp="${_dotfiles_plugins_bundle}.tmp.$$"
        if antidote bundle < "$_dotfiles_plugins_txt" > "$_dotfiles_plugins_tmp" && \
                [[ -s $_dotfiles_plugins_tmp ]]; then
            mv -f "$_dotfiles_plugins_tmp" "$_dotfiles_plugins_bundle"
        else
            rm -f "$_dotfiles_plugins_tmp"
            print -u2 "Warning: Antidote could not refresh the plugin bundle; keeping the previous bundle."
        fi
        unset _dotfiles_plugins_tmp
    fi
    [[ -s $_dotfiles_plugins_bundle ]] && source "$_dotfiles_plugins_bundle"
    unset _dotfiles_plugins_txt _dotfiles_plugins_bundle
fi
unset _dotfiles_antidote

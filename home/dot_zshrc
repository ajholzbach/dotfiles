if [[ ! -o login && -f $HOME/.profile ]]; then
    source "$HOME/.profile"
fi

typeset -U path fpath
[[ -n ${HOMEBREW_PREFIX:-} ]] && fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)

# History and completion (inlined from OMZ path:lib)
HISTFILE=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
# hist_expire_dups_first needs HISTSIZE above SAVEHIST
HISTSIZE=60000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify share_history
setopt auto_menu complete_in_word always_to_end
_dotfiles_zsh_cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
zstyle ':completion:*' menu select
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' use-cache yes
zstyle ':completion:*' cache-path "$_dotfiles_zsh_cache"

# Run the slow compaudit check at most once a day
[[ -d $_dotfiles_zsh_cache ]] || mkdir -p "$_dotfiles_zsh_cache"
autoload -Uz compinit
() {
    setopt local_options extended_glob
    if [[ -n $1(#qN.mh-24) ]]; then
        compinit -C -d "$1"
    else
        compinit -d "$1"
        touch "$1"
    fi
    [[ $1.zwc -nt $1 ]] || zcompile "$1"
} "$_dotfiles_zsh_cache/zcompdump"
unset _dotfiles_zsh_cache

# Lazy-load Conda from common macOS and Linux locations
for _dotfiles_conda_root in \
    /opt/homebrew/Caskroom/miniforge/base \
    /opt/homebrew/Caskroom/miniconda/base \
    /usr/local/Caskroom/miniforge/base \
    /usr/local/Caskroom/miniconda/base \
    "$HOME/miniforge3" \
    "$HOME/miniconda3" \
    "$HOME/anaconda3" \
    /opt/miniforge3 \
    /opt/miniconda3 \
    /opt/conda; do
    if [ -x "$_dotfiles_conda_root/bin/conda" ]; then
        _dotfiles_conda_exe="$_dotfiles_conda_root/bin/conda"
        conda() {
            unset -f conda
            local conda_hook
            if ! conda_hook="$("$_dotfiles_conda_exe" shell.zsh hook 2>/dev/null)" || \
                    [ -z "$conda_hook" ] || ! eval "$conda_hook"; then
                export PATH="${_dotfiles_conda_exe:h}:$PATH"
            fi
            unset _dotfiles_conda_exe
            conda "$@"
        }
        break
    fi
done
unset _dotfiles_conda_root

# Lazy-load NVM
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
for _dotfiles_nvm_script in \
    "$NVM_DIR/nvm.sh" \
    /opt/homebrew/opt/nvm/nvm.sh \
    /usr/local/opt/nvm/nvm.sh; do
    if [ -s "$_dotfiles_nvm_script" ]; then
        nvm() {
            unset -f nvm
            . "$_dotfiles_nvm_script"
            unset _dotfiles_nvm_script
            nvm "$@"
        }
        break
    fi
done
if (( ! $+functions[nvm] )); then
    unset _dotfiles_nvm_script
fi

# Add pnpm's home when it exists
if [ -z "${PNPM_HOME:-}" ]; then
    for _dotfiles_pnpm_home in "$HOME/Library/pnpm" "$HOME/.local/share/pnpm"; do
        if [ -d "$_dotfiles_pnpm_home" ]; then
            export PNPM_HOME="$_dotfiles_pnpm_home"
            break
        fi
    done
    unset _dotfiles_pnpm_home
fi
[[ -n ${PNPM_HOME:-} ]] && path=("$PNPM_HOME" $path)

# Per-machine env (untracked)
if [ -z "${DOTFILES_LOADING_LOCAL_ENV:-}" ] && [ -f "$HOME/.config/local-env.sh" ]; then
    DOTFILES_LOADING_LOCAL_ENV=1
    source "$HOME/.config/local-env.sh"
    unset DOTFILES_LOADING_LOCAL_ENV
fi

if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

if (( $+commands[zoxide] )); then
    eval "$(zoxide init zsh)"
    alias cd='z'
    alias cdo='builtin cd'
fi

if (( $+commands[bat] )); then
    alias cat='bat --plain'
fi

if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l --group-directories-first --icons=auto'
    alias la='eza -a --group-directories-first --icons=auto'
    alias lt='eza -aT --group-directories-first --icons=auto'
fi

alias wget='wget -c'
alias tarnow='tar -acf'
alias untar='tar -xvf'
alias psmem='ps aux | { IFS= read -r _dotfiles_ps_header; print -r -- "$_dotfiles_ps_header"; sort -nrk 4; }'
alias psmem10='ps aux | { IFS= read -r _dotfiles_ps_header; print -r -- "$_dotfiles_ps_header"; sort -nrk 4 | head -n 10; }'

if (( $+commands[fzf] )); then
    if _dotfiles_fzf_init="$(fzf --zsh 2>/dev/null)"; then
        eval "$_dotfiles_fzf_init"
    else
        [ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && \
            source /usr/share/doc/fzf/examples/key-bindings.zsh
        [ -f /usr/share/doc/fzf/examples/completion.zsh ] && \
            source /usr/share/doc/fzf/examples/completion.zsh
    fi
    unset _dotfiles_fzf_init
fi

if (( $+commands[starship] )); then
    eval "$(starship init zsh)"
    # starship.toml has no right_format, so skip the second starship call per prompt
    RPROMPT=''
fi

# For the OMZ git plugin aliases, which expect this OMZ lib function
git_current_branch() {
    command git symbolic-ref --quiet --short HEAD 2>/dev/null ||
        command git rev-parse --short HEAD 2>/dev/null
}

# Keep Antidote last so zsh-syntax-highlighting wraps every widget
if [ -f "$HOME/.antidote/antidote.zsh" ]; then
    # Rebuild the cached bundle only when the plugin list changes
    _dotfiles_plugins_txt="${ZDOTDIR:-$HOME}/.zsh_plugins.txt"
    _dotfiles_plugins_bundle="${XDG_CACHE_HOME:-$HOME/.cache}/antidote/zsh_plugins.zsh"
    if [[ ! $_dotfiles_plugins_bundle -nt $_dotfiles_plugins_txt ]]; then
        mkdir -p "${_dotfiles_plugins_bundle:h}"
        source "$HOME/.antidote/antidote.zsh"
        zstyle ':antidote:bundle:*' zcompile yes
        # Defer only the load, without rerunning prompt hooks or redrawing the prompt
        zstyle ':antidote:bundle:*' defer-options '-a'
        _dotfiles_plugins_tmp="${_dotfiles_plugins_bundle}.tmp.$$"
        if antidote bundle < "$_dotfiles_plugins_txt" > "$_dotfiles_plugins_tmp" && \
                [ -s "$_dotfiles_plugins_tmp" ]; then
            mv -f "$_dotfiles_plugins_tmp" "$_dotfiles_plugins_bundle"
        else
            rm -f "$_dotfiles_plugins_tmp"
            print -u2 "Warning: Antidote could not refresh the plugin bundle; keeping the previous bundle."
        fi
        unset _dotfiles_plugins_tmp
    fi
    [ -s "$_dotfiles_plugins_bundle" ] && source "$_dotfiles_plugins_bundle"
    unset _dotfiles_plugins_txt _dotfiles_plugins_bundle
fi

if [[ ! -o login && -f $HOME/.profile ]]; then
    source "$HOME/.profile"
fi

typeset -U path fpath
fpath=("$HOME/.local/share/zsh/site-functions" ${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/share/zsh/site-functions"} $fpath)

# History and completion settings from OMZ lib
HISTFILE=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
# hist_expire_dups_first needs HISTSIZE above SAVEHIST
HISTSIZE=60000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups \
       hist_ignore_space hist_verify share_history
setopt complete_in_word always_to_end
zstyle ':completion:*' menu select
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' use-cache yes

# Run the slow compaudit check at most once a day
autoload -Uz compinit
() {
    setopt local_options extended_glob
    local dump=$1/zcompdump
    zstyle ':completion:*' cache-path "$1"
    [[ -d $1 ]] || mkdir -p "$1"
    if [[ -n $dump(#qN.mh-24) ]]; then
        compinit -C -d "$dump"
    else
        compinit -d "$dump"
        touch "$dump"
    fi
    [[ $dump.zwc -nt $dump ]] || zcompile "$dump"
} "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"

# Lazy-load Conda from CONDA_EXE, PATH, or common macOS and Linux locations
() {
    (( $# )) || return
    typeset -g _dotfiles_conda_exe=$1
    conda() {
        unset -f conda
        local hook
        hook=$("$_dotfiles_conda_exe" shell.zsh hook 2>/dev/null) && [[ -n $hook ]] && eval "$hook" ||
            path=("${_dotfiles_conda_exe:h}" $path)
        unset _dotfiles_conda_exe
        conda "$@"
    }
} ${CONDA_EXE:+$CONDA_EXE(N-*)} $commands[conda] \
    {$HOME,/opt}/{miniforge3,miniconda3,anaconda3,mambaforge}/bin/conda(N-*) /opt/conda/bin/conda(N-*) \
    ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/Caskroom/{miniforge,miniconda,mambaforge,anaconda}/base/bin/conda(N-*)}

# Lazy-load NVM
export NVM_DIR=${NVM_DIR:-$HOME/.nvm}
() {
    (( $# )) || return
    typeset -g _dotfiles_nvm_script=$1
    nvm() {
        unset -f nvm
        . "$_dotfiles_nvm_script"
        unset _dotfiles_nvm_script
        nvm "$@"
    }
} $NVM_DIR/nvm.sh(N-.L+0) ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/opt/nvm/nvm.sh(N-.L+0)}

# Add pnpm's home when it exists
[[ -n $PNPM_HOME ]] || () { (( $# )) && export PNPM_HOME=$1 } $HOME/{Library,.local/share}/pnpm(N/)
[[ -n $PNPM_HOME ]] && path=("$PNPM_HOME" $path)

if (( $+commands[mise] )); then
    eval "$(mise activate zsh)"
fi

# Tool init commands print the same script each time, but take 5 to 10 ms each
# Source the script from a cache file, and rebuild the file when the tool binary changes
zmodload -F zsh/stat b:zstat
_dotfiles_source_init() {
    local bin=${commands[$1]:A} cache=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/$1-init.zsh key line init
    local -a mtime
    [[ -n $bin ]] && zstat -A mtime +mtime -- "$bin" || return
    key="# $bin $mtime"
    [[ -r $cache ]] && read -r line < "$cache"
    if [[ $line != "$key" ]]; then
        init=$("$@" 2>/dev/null) && [[ -n $init ]] || return
        # Starship runs a 7 ms subprocess to set PROMPT2
        # Quote the command, so the prompt runs it only when it shows PROMPT2
        init=${init/PROMPT2=\"\$\(/PROMPT2=\'\$\(}
        init=${init/--continuation\)\"/--continuation)\'}
        # Another shell can start while this shell writes the cache
        # Write a temp file, then rename the temp file to the cache file
        print -r -- "$key"$'\n'"$init" >| "$cache.$$" && mv -f "$cache.$$" "$cache"
    fi
    source "$cache"
}

if _dotfiles_source_init zoxide init zsh --cmd cd; then
    alias cdo='builtin cd'
fi

if (( $+commands[bat] )); then
    alias cat='bat --plain'
fi

if (( $+commands[eza] )); then
    alias ls='eza --group-directories-first --icons=auto'
    alias ll='eza -l --group-directories-first --icons=auto'
    alias la='eza -a --group-directories-first --icons=auto'
    alias lt='eza -aT --group-directories-first --icons=auto'
fi

# fzf before 0.48 has no --zsh option, but Debian and Ubuntu ship its scripts
# Use those scripts when fzf --zsh fails
if (( $+commands[fzf] )) && ! _dotfiles_source_init fzf --zsh; then
    for _dotfiles_fzf_script in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh(N); do
        source "$_dotfiles_fzf_script"
    done
    unset _dotfiles_fzf_script
fi

if _dotfiles_source_init starship init zsh; then
    # starship.toml has no right_format, but the right prompt still runs starship
    # Clear the right prompt
    RPROMPT=''
fi
unfunction _dotfiles_source_init

# The OMZ git plugin aliases expect this OMZ lib function
git_current_branch() {
    command git symbolic-ref --quiet --short HEAD 2>/dev/null ||
        command git rev-parse --short HEAD 2>/dev/null
}

# zsh-syntax-highlighting must wrap every widget, so load the plugins last
# macOS can purge ~/Library/Caches, so keep the clones in the data directory
# Keep the bundle with the clones, so a lost clone directory also loses the bundle
_dotfiles_antidote_home=${XDG_DATA_HOME:-$HOME/.local/share}/antidote
zstyle ':antidote:home' dir "$_dotfiles_antidote_home"
zstyle ':antidote:static' file "$_dotfiles_antidote_home/zsh_plugins.zsh"
zstyle ':antidote:bundle:*' zcompile yes
# Defer only the plugin load, and skip the prompt hooks and redraw
zstyle ':antidote:bundle:*' defer-options '-a'

# Loading Antidote takes 4 ms, so load it from ~/.antidote or Homebrew on its first use
() {
    (( $# )) || return
    functions[antidote]="unfunction antidote; source ${(q)1}; antidote \"\$@\""
} $HOME/.antidote/antidote.zsh(N) ${HOMEBREW_PREFIX:+$HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh(N)}

# antidote load rebuilds the bundle when the plugin list changes or antidote update removes .antidote.load
# In other cases, source the bundle without Antidote
if [[ $_dotfiles_antidote_home/zsh_plugins.zsh -nt ${ZDOTDIR:-$HOME}/.zsh_plugins.txt &&
        -e $_dotfiles_antidote_home/.antidote.load ]]; then
    source "$_dotfiles_antidote_home/zsh_plugins.zsh"
elif (( $+functions[antidote] )); then
    # On failure, antidote load sources the previous bundle and tries again at the next start
    antidote load || print -u2 'Warning: Antidote could not refresh the plugin bundle.'
fi
unset _dotfiles_antidote_home

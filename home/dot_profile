if [ -z "${XDG_CONFIG_HOME:-}" ]; then
    export XDG_CONFIG_HOME="$HOME/.config"
fi

# The managed configs stay in ~/.config even when XDG_CONFIG_HOME is custom
export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"
export BAT_CONFIG_PATH="${BAT_CONFIG_PATH:-$HOME/.config/bat/config}"
export COPYFILE_DISABLE="${COPYFILE_DISABLE:-1}"
# fzf fails on every call when this file is missing
if [ -z "${FZF_DEFAULT_OPTS_FILE:-}" ] && [ -r "$HOME/.config/fzf/fzfrc" ]; then
    export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"
fi

# Always prepend, because path_helper moves inherited entries after /usr/bin
for user_bin in "$HOME/bin" "$HOME/.local/bin"; do
    [ -d "$user_bin" ] && PATH="$user_bin${PATH:+:$PATH}"
done
unset user_bin
export PATH

for brew_prefix in /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [ -x "$brew_prefix/bin/brew" ]; then
        export HOMEBREW_PREFIX="$brew_prefix"
        export HOMEBREW_DOWNLOAD_CONCURRENCY="${HOMEBREW_DOWNLOAD_CONCURRENCY:-auto}"
        PATH="$brew_prefix/bin:$brew_prefix/sbin${PATH:+:$PATH}"
        break
    fi
done
unset brew_prefix

export CONDA_AUTO_ACTIVATE_BASE="${CONDA_AUTO_ACTIVATE_BASE:-false}"

if [ -z "${EDITOR:-}" ]; then
    if command -v vim >/dev/null 2>&1; then
        EDITOR=vim
    elif command -v vi >/dev/null 2>&1; then
        EDITOR=vi
    elif command -v nano >/dev/null 2>&1; then
        EDITOR=nano
    fi
fi

if [ -n "${EDITOR:-}" ]; then
    export EDITOR
    export VISUAL="${VISUAL:-$EDITOR}"
fi

# local-env.sh is for Bash and zsh, and a display manager can run this file with sh
# Load the untracked per-machine environment file only in Bash and zsh
if [ -n "${BASH_VERSION:-}${ZSH_VERSION:-}" ] && [ -z "${DOTFILES_LOADING_LOCAL_ENV:-}" ] &&
        [ -f "$HOME/.config/local-env.sh" ]; then
    DOTFILES_LOADING_LOCAL_ENV=1
    . "$HOME/.config/local-env.sh"
    unset DOTFILES_LOADING_LOCAL_ENV
fi

{{- /* The Homebrew fallbacks match find_tool in common.sh. A PATH without Homebrew must not change the rendered output */ -}}
{{- $path := lookPath . -}}
{{- range list (printf "/opt/homebrew/bin/%s" .) (printf "/usr/local/bin/%s" .) -}}
{{-   if and (not $path) (stat .) -}}
{{-     $path = . -}}
{{-   end -}}
{{- end -}}
{{- $path -}}

{{- $tools := false -}}
{{- if ne .chezmoi.os "windows" -}}
{{-   $tools = promptBoolOnce . "tools" "tools" false -}}
{{- end -}}
{{- $data := dict "tools" $tools -}}
{{- /* Keep machine-local data when chezmoi init regenerates this file */ -}}
{{- with (index . "kube") -}}
{{-   $_ := set $data "kube" . -}}
{{- end -}}
{{- /* Scripts that run on every apply would otherwise always show in diff */ -}}
{{ dict "data" $data "diff" (dict "exclude" (list "scripts")) | toToml }}
